# 服务端口
PORT=3000

# 环境
NODE_ENV=development

# ===== 数据源 API（客户自备，未配置则自动跳过）=====
SERPAPI_KEY=your_serpapi_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CX=your_search_engine_id_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# RedditDate（客户提供）
REDDITDATE_API_KEY=your_redditdate_api_key_here

# ===== 大模型归类（客户自备 Key；调用费用由客户承担，开发方只做对接）=====
# 兼容 OpenAI Chat Completions 接口
# OpenAI 示例：
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# 火山方舟 / 豆包示例：
# LLM_API_KEY=ark-...（控制台 API Key 管理里的 Key 值，不是名称）
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=ep-xxxxxxxx（推理接入点 ID；或已开通的模型 ID）
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_BATCH_SIZE=8
LLM_TIMEOUT_MS=30000
